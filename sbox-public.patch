diff --git a/engine/Launcher/SboxServer/Launcher.cs b/engine/Launcher/SboxServer/Launcher.cs
index f8cf0c29..38fa5923 100644
--- a/engine/Launcher/SboxServer/Launcher.cs
+++ b/engine/Launcher/SboxServer/Launcher.cs
@@ -22,6 +22,15 @@ public class DedicatedServerAppSystem : AppSystem
 
 	public override void Init()
 	{
+		// engine-shim: every managed log line to stdout, the spike's eyes
+		var shown = new System.Collections.Generic.HashSet<string>();
+		Sandbox.Diagnostics.Logging.OnMessage += e =>
+		{
+			if ( !shown.Add( e.Message ) ) return; // each message once
+			System.Console.WriteLine( $"[{e.Level}] {e.Logger}: {e.Message}" );
+			if ( e.Exception is not null ) System.Console.WriteLine( e.Exception.ToString() );
+		};
+
 		// Redirecting console output (docker/wine/etc..) won't support this overlay, so don't bother with it
 		if ( !Console.IsOutputRedirected )
 		{
@@ -43,14 +52,21 @@ public class DedicatedServerAppSystem : AppSystem
 
 		CreateGame();
 
+		// engine-shim: +shimclient <address> boots a headless player instead, and connects there
+		shimClient = Sandbox.Utility.CommandLine.GetSwitch( "+shimclient", null );
+
 		var createInfo = new AppSystemCreateInfo()
 		{
 			WindowTitle = "s&box server",
-			Flags = AppSystemFlags.IsDedicatedServer | AppSystemFlags.IsGameApp | AppSystemFlags.IsConsoleApp
+			Flags = shimClient is null ? AppSystemFlags.IsDedicatedServer | AppSystemFlags.IsGameApp | AppSystemFlags.IsConsoleApp : AppSystemFlags.IsGameApp | AppSystemFlags.IsConsoleApp
 		};
 
 		InitGame( createInfo );
 
+		// engine-shim: +shimgame loads a local project through the game command (the engine runs +game itself, but only as a package to download)
+		// with the open native engine, the launcher does
+		shimGame = Sandbox.Utility.CommandLine.GetSwitch( "+shimgame", null );
+
 		// No game specified, show some help
 		if ( !Environment.CommandLine.Contains( "game " ) )
 		{
@@ -60,9 +76,18 @@ public class DedicatedServerAppSystem : AppSystem
 		console?.Update();
 	}
 
+	string shimGame;
+	string shimClient;
+	int shimFrames;
+
 	protected override bool RunFrame()
 	{
 		console?.Update();
+		// engine-shim: +game once the game instance has registered its commands
+		if ( shimGame is not null && ++shimFrames == 30 ) { System.Console.WriteLine( $"engine-shim: dedicated={Application.IsDedicatedServer} editor={Application.IsEditor} headless={Application.IsHeadless}" ); ConVarSystem.Run( $"game {shimGame}" ); }
+		// engine-shim: +shimhost opens the lobby, as a networked game's NetworkHelper would, once the game has had time to load
+		if ( shimGame is not null && shimFrames == 330 && Sandbox.Utility.CommandLine.HasSwitch( "+shimhost" ) ) ConVarSystem.Run( "host" );
+		if ( shimClient is not null && ++shimFrames == 30 ) { System.Console.WriteLine( $"engine-shim: a player, dedicated={Application.IsDedicatedServer} headless={Application.IsHeadless}, connecting to {shimClient}" ); ConVarSystem.Run( $"connect {shimClient}" ); }
 
 		return base.RunFrame();
 	}
