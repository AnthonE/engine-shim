# /etc/elo-shim/<slug>.env: one game server's settings (engine-shim README,
# "What runs now"). install-server.sh fills <slug>, <host> and <port>.

# where players reach it: the shard row's addr, and what a sign-in names
ENGINE2_PUBLIC_ADDR=<host>:<port>
# only a sign-in for this address gets in (unset: a development server)
ENGINE2_SIWE_DOMAINS=<host>:<port>
# the title in the Elo Pros catalog: what the launcher signs for
ENGINE2_ELO_GAME=<slug>
# its certificate, the name's (Let's Encrypt; deploy/letsencrypt-hook.sh copies it here)
ENGINE2_TLS_CERT=/etc/elo-shim/tls/fullchain.pem
ENGINE2_TLS_KEY=/etc/elo-shim/tls/privkey.pem
# its identity across restarts (made on first start)
ENGINE2_HOST_KEY=/var/lib/elo-shim/<slug>/host.key
# its shard row, kept current; copied to the origin's $SCRY_DEPOTS_DIR/<slug>/servers.json
ENGINE2_SHARDLIST=/var/lib/elo-shim/<slug>/servers.json
# player counts, plain HTTP on loopback; nginx serves it at the https url
# (deploy/nginx-status.conf), on the same host as the addr, as the origin asks
ENGINE2_STATUS_ADDR=127.0.0.1:<status port>
ENGINE2_STATUS_URL=https://<host>/shim/<slug>/status.json
# a title that sells copies: the origin checks each signed-in player's
#ENGINE2_ELO_ORIGIN=https://elopros.com
# s&box's server arguments: its port (the convar), and a hostname or player cap if wanted
SHIM_ARGS=+port <port>
